MINIAPP_ENABLED=false
MINIAPP_DEV_MODE=false
MINIAPP_OWNER_ONLY=true
MINIAPP_OWNER_USER_ID=
BOT_TOKEN=
MINIAPP_HOST=127.0.0.1
MINIAPP_PORT=8081
# Replace example.com and __PROJECT_ROOT__ before a production rollout.
MINIAPP_PUBLIC_URL=https://example.com
MINIAPP_ALLOWED_ORIGINS=https://example.com
MINIAPP_DATA_ROOT=__PROJECT_ROOT__

MINIAPP_AUTH_MAX_AGE_SECONDS=3600
MINIAPP_RATE_LIMIT_REQUESTS=60
MINIAPP_RATE_LIMIT_WINDOW_SECONDS=60
MINIAPP_MAX_REQUEST_BODY_BYTES=65536
MINIAPP_CACHE_TTL_SECONDS=5
MINIAPP_QUERY_TIMEOUT_SECONDS=2.0
MINIAPP_MAX_SOURCE_ROWS=10000
MINIAPP_SIMILAR_MIN_SAMPLE=20

# Railway-only runtime ingest: generate a dedicated random secret. Never reuse BOT_TOKEN.
RUNTIME_INGEST_SECRET=
RUNTIME_INGEST_STALE_AFTER_SECONDS=900
RUNTIME_INGEST_MAX_PAYLOAD_BYTES=1048576
RUNTIME_INGEST_MAX_SNAPSHOT_AGE_SECONDS=3600
